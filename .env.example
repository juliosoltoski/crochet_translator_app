# Future provider configuration.
# Keep recipe text, OCR output, and translated text out of logs and analytics.

VITE_DEFAULT_TARGET_VARIANT=pt-PT
VITE_TRANSLATION_API_URL=http://localhost:8787

# Server-side translation provider. Keep Gemini keys server-side only.
PORT=8787
CORS_ORIGIN=http://localhost:5173
TRANSLATION_PROVIDER=passthrough
GEMINI_TRANSLATION_MODEL=gemini-2.5-flash
# GEMINI_API_KEY=
# GOOGLE_API_KEY=
MAX_TRANSLATION_INPUT_CHARACTERS=50000

# Server-side OCR provider. Set to gemini to enable Gemini Vision OCR for images.
# Requires GEMINI_API_KEY to be set. Falls back to browser Tesseract if not configured.
OCR_PROVIDER=passthrough
# GEMINI_OCR_MODEL=gemini-2.5-flash
MAX_OCR_IMAGE_BYTES=10485760
